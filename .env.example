# Copiar este archivo a .env y ajustar los valores.
# .env NO se sube al repositorio.

# URL base de la aplicación bajo prueba (Practice Software Testing)
BASE_URL=https://practicesoftwaretesting.com/

# Correo del candidato para el registro (se le agrega un sufijo único en cada ejecución)
REGISTER_EMAIL=

# URL de login esperada tras el registro
REGISTER_LOGIN_URL=https://practicesoftwaretesting.com/auth/login
